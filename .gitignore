# личные настройки (создаются при первом запуске из настроек по умолчанию в main.py)
config.json

# скачиваемая модель распознавания речи — ставится через setup.bat
models/

# журнал, отчёты диагностики, образцы голоса — личные данные
capri.log
capri.fault.log
reports/
samples/

# служебное
__pycache__/
*.pyc
*.tmp

# кэш векторного RAG по коду (строится локально при старте)
.capri_rag/

# переопределение путей и уровня журнала (src/main/config.py)
.env
.mypy_cache/
.ruff_cache/
